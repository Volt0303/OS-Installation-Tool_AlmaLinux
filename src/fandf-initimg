#!/usr/bin/env bash
#
# イメージ保存領域の初期化（GPT + ext4 + ラベル付与）
#   fandf-initimg            対話でディスクを選択
#   fandf-initimg /dev/sdX   直接指定
#
# ※ 指定ディスクの内容はすべて消去されます
#
set -uo pipefail
. /usr/local/bin/fandf-common

echo; line; echo "  === 保存領域の初期化 ==="; line; echo
echo "  マスターイメージを保存するディスクを、ext4（ラベル: $IMGLABEL）で初期化します。"
echo "  通常はUSBを作成するときに一度だけ実行します。"
echo

DISK="${1:-}"
if [ -z "$DISK" ]; then
  DISK="$(select_disk)" || { c_warn "中止しました"; exit 0; }
fi
[ -b "$DISK" ] || { c_err "$DISK は有効なディスクではありません"; exit 1; }

# --- 起動メディアは対象外 ------------------------------------------------
LD="$(live_disk || true)"
[ -n "$LD" ] && [ "$DISK" = "/dev/$LD" ] && { c_err "起動メディアは初期化できません"; exit 1; }

# --- 現在の状態を表示 ----------------------------------------------------
echo
echo "  対象ディスク:"
lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MODEL,SERIAL "$DISK" | sed 's/^/    /'
echo

# --- OSが入っていそうなディスクは強く警告（マスターの誤消去防止）--------
RISK=""
lsblk -lno FSTYPE "$DISK" 2>/dev/null | grep -qi 'LVM2_member' && RISK="LVM"
lsblk -lno PARTTYPENAME "$DISK" 2>/dev/null | grep -qi 'EFI System' && RISK="${RISK:+$RISK/}EFI"
if [ -n "$RISK" ]; then
  line
  c_err "  ⚠ このディスクにはOSが入っている可能性があります（$RISK を検出）"
  c_err "  ⚠ マスターディスクを選んでいないか、必ず確認してください"
  line
fi

c_warn "  ※ $DISK の内容はすべて消去されます（取り消せません）"
read -rp "初期化しますか？ (y/N): " YN
[ "${YN,,}" = "y" ] || { c_warn "中止しました"; exit 0; }

# --- 実行 ---------------------------------------------------------------
echo
echo "  - 既存のパーティション情報を消去"
umount "$DISK"?* 2>/dev/null || true
wipefs -a "$DISK" >/dev/null 2>&1 || true

echo "  - GPT パーティションを作成"
parted -s "$DISK" mklabel gpt mkpart primary ext4 1MiB 100% \
  || { c_err "パーティション作成に失敗しました"; exit 1; }
partprobe "$DISK" >/dev/null 2>&1 || true
udevadm settle >/dev/null 2>&1 || sleep 2

PART="$(lsblk -lno NAME,TYPE "$DISK" | awk '$2=="part"{print "/dev/"$1}' | head -1)"
[ -b "$PART" ] || { c_err "パーティションが認識できません"; exit 1; }

echo "  - ext4 で初期化（ラベル: $IMGLABEL）"
mkfs.ext4 -q -F -L "$IMGLABEL" "$PART" || { c_err "フォーマットに失敗しました"; exit 1; }

echo
c_ok "  初期化完了: $PART  (ラベル: $IMGLABEL)"
echo "  メニューに戻り「1: マスターイメージ 抽出」を実行できます。"
