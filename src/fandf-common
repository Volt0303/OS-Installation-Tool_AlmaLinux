#!/usr/bin/env bash
# 共通関数（他スクリプトから source して使用）

IMGDIR="/home/partimag"          # イメージ保存領域（USBの第2区画）
LOGDIR="$IMGDIR/logs"
LOGFILE="${LOGFILE:-}"

c_ok()   { printf '\033[1;32m%s\033[0m\n' "$*"; }
c_warn() { printf '\033[1;33m%s\033[0m\n' "$*"; }
c_err()  { printf '\033[1;31m%s\033[0m\n' "$*"; }
line()   { printf '%s\n' "------------------------------------------------------------"; }

# --- ログ ---------------------------------------------------------------
log_init() {
  mkdir -p "$LOGDIR" 2>/dev/null || true
  LOGFILE="$LOGDIR/$(date +%Y%m%d-%H%M%S)-$1.log"
  log "=== $1 開始 ==="
}
log()  { [ -n "$LOGFILE" ] && printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOGFILE" 2>/dev/null || true; }
logj() { # 機械可読ログ（1イベント1行）
  [ -n "$LOGFILE" ] || return 0
  printf '{"time":"%s","event":"%s","detail":"%s"}\n' "$(date -Is)" "$1" "${2:-}" \
    >>"${LOGFILE%.log}.jsonl" 2>/dev/null || true
}

# --- 起動USBの特定（誤消去防止の要）------------------------------------
live_disk() {
  local dev=""
  for m in /run/live/medium /lib/live/mount/medium /run/live/findiso; do
    dev="$(findmnt -no SOURCE "$m" 2>/dev/null | head -1)" && [ -n "$dev" ] && break
  done
  [ -n "$dev" ] || return 1
  lsblk -no pkname "$dev" 2>/dev/null | head -1
}

# --- イメージ保存領域のマウント（USB第2区画）---------------------------
mount_imgdir() {
  mountpoint -q "$IMGDIR" && return 0
  local ld part
  ld="$(live_disk)" || { c_err "起動USBを特定できません"; return 1; }
  part="$(lsblk -lno NAME,TYPE "/dev/$ld" | awk '$2=="part"{print $1}' | sed -n 2p)"
  [ -n "$part" ] || { c_err "イメージ保存領域（第2区画）が見つかりません"; return 1; }
  mkdir -p "$IMGDIR"
  mount "/dev/$part" "$IMGDIR" || { c_err "/dev/$part のマウントに失敗しました"; return 1; }
}

# --- ディスク一覧（起動USBは自動除外）----------------------------------
list_disks() {
  local ld; ld="$(live_disk || true)"
  lsblk -dno NAME,SIZE,MODEL,SERIAL,TYPE 2>/dev/null | awk '$NF=="disk"' | while read -r n s m sn _; do
    [ "$n" = "$ld" ] && continue                       # 起動USBは対象外
    printf '%s\t%s\t%s\t%s\n' "$n" "$s" "${m:-不明}" "${sn:-不明}"
  done
}

select_disk() { # 対象ディスクを番号で選ばせ、/dev/xxx を返す
  local -a names=() rows=()
  while IFS=$'\t' read -r n s m sn; do
    names+=("$n"); rows+=("$(printf '%-8s %-8s %-22s SN:%s' "$n" "$s" "$m" "$sn")")
  done < <(list_disks)
  [ ${#names[@]} -gt 0 ] || { c_err "対象ディスクが検出されません。接続を確認してください"; return 1; }
  echo "===== 対象ディスク一覧（起動USBは自動的に除外されています）=====" >&2
  local i; for i in "${!rows[@]}"; do printf '  [%d] %s\n' "$i" "${rows[$i]}" >&2; done
  local sel; read -rp "番号を選択（中止は q）: " sel
  [[ "$sel" =~ ^[0-9]+$ ]] && [ -n "${names[$sel]:-}" ] || return 1
  echo "/dev/${names[$sel]}"
}

# --- イメージ一覧 -------------------------------------------------------
list_images() { find "$IMGDIR" -maxdepth 1 -mindepth 1 -type d ! -name logs -printf '%f\n' 2>/dev/null | sort; }

select_image() {
  local -a imgs=(); mapfile -t imgs < <(list_images)
  [ ${#imgs[@]} -gt 0 ] || { c_err "イメージがありません"; return 1; }
  echo "===== イメージ一覧 =====" >&2
  local i; for i in "${!imgs[@]}"; do
    printf '  [%d] %-28s %s\n' "$i" "${imgs[$i]}" "$(du -sh "$IMGDIR/${imgs[$i]}" 2>/dev/null | cut -f1)" >&2
  done
  local sel; read -rp "番号を選択（中止は q）: " sel
  [[ "$sel" =~ ^[0-9]+$ ]] && [ -n "${imgs[$sel]:-}" ] || return 1
  echo "${imgs[$sel]}"
}

pause() { echo; read -rp "Enterキーで続行: " _; }
